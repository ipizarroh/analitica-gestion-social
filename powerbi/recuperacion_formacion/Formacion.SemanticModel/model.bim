        "measures": [
          {
            "name": "Personas registradas",
            "expression": "COALESCE(COUNTROWS(DimPersona), 0)",
            "description": "Personas del universo registrado, incluso sin inscripción.",
            "formatString": "#,0"
          },
          {
            "name": "Con CRM",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(DimPersona[EnCRM] = 1))",
            "description": "Bandera al corte; no se utiliza información futura.",
            "formatString": "#,0"
          },
          {
            "name": "Sin CRM",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(DimPersona[EnCRM] = 0))",
            "description": "No registrado en la fuente sintética CRM.",
            "formatString": "#,0"
          },
          {
            "name": "Con cursos",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(DimPersona[ConCurso] = 1))",
            "description": "Personas, no inscripciones.",
            "formatString": "#,0"
          },
          {
            "name": "Sin cursos",
            "expression": "CALCULATE([Personas registradas], KEEPFILTERS(DimPersona[ConCurso] = 0))",
            "description": "Incluye registradas sin inscripción.",
            "formatString": "#,0"
          },
          {
            "name": "Inscripciones",
            "expression": "COALESCE(COUNTROWS(FactInscripcion), 0)",
            "description": "Grano inscripción única en un corte fijo.",
            "formatString": "#,0"
          },
          {
            "name": "Aprobadas",
            "expression": "CALCULATE([Inscripciones], KEEPFILTERS(FactInscripcion[Estado] = \"Aprobado\"))",
            "description": "Cuenta inscripciones aprobadas; incluye cursos aún abiertos.",
            "formatString": "#,0"
          },
          {
            "name": "En curso",
            "expression": "CALCULATE([Inscripciones], KEEPFILTERS(FactInscripcion[Estado] = \"En curso\"))",
            "description": "Inscripciones en curso al corte.",
            "formatString": "#,0"
          },
          {
            "name": "Sin avance",
            "expression": "CALCULATE([Inscripciones], KEEPFILTERS(FactInscripcion[Estado] = \"Sin avance\"))",
            "description": "Inscripciones sin avance al corte.",
            "formatString": "#,0"
          },
          {
            "name": "Cobertura CRM",
            "expression": "DIVIDE([Con CRM], [Personas registradas])",
            "description": "Mismo universo registrado bajo los filtros.",
            "formatString": "0.0%"
          }
        ]
      },
