// FactJornada contiene universo esperado, incluso Sin registro. Desktop pendiente.
Jornadas esperadas = COALESCE(COUNTROWS(FactJornada), 0)
Jornadas recibidas = CALCULATE(COALESCE(COUNTROWS(FactJornada), 0), KEEPFILTERS(FactJornada[estado] <> "Sin registro"))
Presentes = CALCULATE(COALESCE(COUNTROWS(FactJornada), 0), KEEPFILTERS(FactJornada[estado] = "Presente"))
Sin registro = CALCULATE(COALESCE(COUNTROWS(FactJornada), 0), KEEPFILTERS(FactJornada[estado] = "Sin registro"))
Cobertura = DIVIDE([Jornadas recibidas], [Jornadas esperadas])
Asistencia observada = DIVIDE([Presentes], [Jornadas recibidas])
Asistencia sobre esperadas = DIVIDE([Presentes], [Jornadas esperadas])
