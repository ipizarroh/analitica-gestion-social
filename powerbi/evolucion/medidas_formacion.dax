// Requiere DimCorte[corte] seleccionado único. Especificación no ejecutada en Desktop.
Inscripciones al corte = IF(HASONEVALUE(DimCorte[corte]), COUNTROWS(FactSeguimiento))
Personas al corte = IF(HASONEVALUE(DimCorte[corte]), DISTINCTCOUNT(FactSeguimiento[persona_id]))
Inscripciones cursos cerrados = IF(HASONEVALUE(DimCorte[corte]), CALCULATE(COUNTROWS(FactSeguimiento), KEEPFILTERS(FactSeguimiento[curso_cerrado_al_corte] = TRUE())))
Aprobadas cursos cerrados = IF(HASONEVALUE(DimCorte[corte]), CALCULATE(COUNTROWS(FactSeguimiento), KEEPFILTERS(FactSeguimiento[curso_cerrado_al_corte] = TRUE()), KEEPFILTERS(FactSeguimiento[estado] = "Aprobado")))
Aprobación cursos cerrados = DIVIDE([Aprobadas cursos cerrados], [Inscripciones cursos cerrados])
Personas con CRM demo = IF(HASONEVALUE(DimCorte[corte]), CALCULATE(DISTINCTCOUNT(FactSeguimiento[persona_id]), KEEPFILTERS(DimPersona[registro_crm_demo] = TRUE())))
Cobertura CRM demo = DIVIDE([Personas con CRM demo], [Personas al corte])
